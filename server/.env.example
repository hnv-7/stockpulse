# Copy to .env for self-hosting, or set these as environment variables on your host (e.g. Vercel).
# Never commit real values.

# Public https URL of the deployed app (no trailing slash). Used for the Google redirect URI:
#   <APP_BASE_URL>/api/auth/callback
APP_BASE_URL=https://your-app.example.com

# Postgres connection string (e.g. from Neon). Must use sslmode=require.
DATABASE_URL=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string shared with the scheduler (GitHub Actions secret CRON_SECRET). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional: email alerts for users who opt in (any SMTP provider; use an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional per-user limits.
MAX_HOLDINGS_PER_USER=50
MAX_RULES_PER_USER=20

# Self-hosting only: bind address and port (defaults 127.0.0.1:4000).
# HOST=127.0.0.1
# PORT=4000
